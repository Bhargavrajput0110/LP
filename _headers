# Netlify Headers — Cache-Control for all static assets
# These headers dramatically improve repeat-visit performance

# HTML — never cache (always fresh)
/index.html
  Cache-Control: no-cache, must-revalidate

# CSS & JS — cache 1 year (versioned by content)
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/main.js
  Cache-Control: public, max-age=31536000, immutable

# Images — cache 1 week
/public/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fonts — cache 1 year (they never change)
/public/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# WebManifest — cache 1 day
/site.webmanifest
  Cache-Control: public, max-age=86400

# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
